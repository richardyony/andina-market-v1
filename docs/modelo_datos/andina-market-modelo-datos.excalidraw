  {
   "id": "text-254b010c4759",
   "type": "text",
   "x": 574,
   "y": 1002,
   "width": 986.7,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
